{
    "name": "omnitrade/amazon",
    "type": "library",
    "description": "Omnitrade Amazon: products read through Amazon's Creators API (the successor of the Product Advertising API 5) and affiliate links with the Associates tag.",
    "keywords": ["amazon", "creators api", "associates", "affiliate", "omnitrade"],
    "license": "LGPL-3.0-or-later",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "glitchr/omnitrade": "^1.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {"phpunit/phpunit": "^11.0", "symfony/http-client": "^6.4|^7.0|^8.0"},
    "suggest": {"symfony/http-client": "The HTTP client the API is called through"},
    "autoload": {"psr-4": {"Omnitrade\\Amazon\\": ""}, "exclude-from-classmap": ["/Tests/"]},
    "autoload-dev": {"psr-4": {"Omnitrade\\Amazon\\Tests\\": "Tests/"}},
    "config": {"sort-packages": true}
}
